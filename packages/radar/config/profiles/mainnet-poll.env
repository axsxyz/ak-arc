# ─────────────────────────────────────────────────────────────────────────────
# Profile: Arc MAINNET over the public HTTP RPC (no WebSocket available).
# Use NOW, before a QuickNode mainnet WSS endpoint exists.   npm run start:mainnet-poll
#
# NON-SECRET settings only. Webhooks / private RPC keys stay in .env.
# Precedence: shell (set / cross-env) > this file > .env
# Kill-switches DISCORD_DRY_RUN / ALERTS_PING_ENABLED are NOT set here on purpose:
# they come from your .env (or the command line) so you always control them.
# ─────────────────────────────────────────────────────────────────────────────
ARC_NETWORK=mainnet
ARC_MAINNET_HTTP_URL=https://rpc.arc-scan.org
# Empty WSS -> HTTP polling. Allowed on mainnet only with the flag below.
ARC_MAINNET_WSS_URL=
ALLOW_MAINNET_HTTP_POLLING=1

# Poll every second (Arc ≈ 2 blocks/s). Next poll starts only after the previous finished.
POLL_INTERVAL_MS=1000
# Public RPC handled 5,000-block getLogs fine (50,000 -> HTTP 503). Failing ranges auto-split.
RPC_GETLOGS_MAX_RANGE=2000
RPC_MAX_RPS=8
# Catch-up after hiccups / restarts: up to ~2.8h of blocks.
BACKFILL_MAX_BLOCKS=20000
# Replay the last N hours on boot with Discord muted (seeds pools, curves, pad stats, major baselines).
WARM_START_HOURS=6

# Separate state from testnet; gate must be real on mainnet.
DB_PATH=data/radar-mainnet.sqlite
ALLOW_EMPTY_CHAIN=0

# Mainnet thresholds (tunable — recalibrate after a day of logs)
ALERT_LP_USD=50000
ALERT_LP_WATCH_USD=10000
ALERT_LP_WINDOW_SEC=120
ALERT_MIGRATE_VOL_USD=25000
ALERT_WALLET_AGE_SEC=120
ALERT_WALLET_BUY_USD=1000
ALERT_ANOMALY_Z=5
ALERT_ANOMALY_PCT=100
ALERT_ANOMALY_MIN_VOL_USD=5000
MAJOR_DIGEST_SEC=900

# CCTP bridge flow (config/watchlists/infra.yaml cctp: block has the contract addresses)
BRIDGE_FOLLOW_MIN_USD=10000
BRIDGE_FOLLOW_MINUTES=30
BRIDGE_DIGEST_SEC=300

# Holder backfill for MAJOR_DIGEST holders≈ / top10% (background job; progress checkpointed in DB_PATH)
HOLDERS_BACKFILL=1
HOLDERS_RPC_MAX_RPS=2
HOLDERS_BACKFILL_RANGE=10000
HOLDERS_BACKFILL_MAX_BLOCKS=30000000
HOLDERS_SYNC_SEC=60
HOLDERS_CHECKPOINT_SEC=120

# Major price source: deepest trusted pool must hold at least this much USDC (dust pools never price a major)
MAJOR_PRICE_MIN_LP_USD=1000
MAJOR_DEPTH_REFRESH_SEC=300
