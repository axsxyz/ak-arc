# ─────────────────────────────────────────────────────────────────────────────
# Profile: Arc MAINNET with a real WebSocket endpoint (QuickNode, once available).
#   Put ARC_MAINNET_HTTP_URL + ARC_MAINNET_WSS_URL (secrets) in .env, then: npm run start:mainnet
# NON-SECRET settings only. Precedence: shell > this file > .env
# ─────────────────────────────────────────────────────────────────────────────
ARC_NETWORK=mainnet
ALLOW_MAINNET_HTTP_POLLING=0
RPC_GETLOGS_MAX_RANGE=5
RPC_MAX_RPS=10
BACKFILL_MAX_BLOCKS=20000
WARM_START_HOURS=6
DB_PATH=data/radar-mainnet.sqlite
ALLOW_EMPTY_CHAIN=0

ALERT_LP_USD=50000
ALERT_LP_WATCH_USD=10000
ALERT_LP_WINDOW_SEC=120
ALERT_MIGRATE_VOL_USD=25000
ALERT_WALLET_AGE_SEC=120
ALERT_WALLET_BUY_USD=1000
ALERT_ANOMALY_Z=5
ALERT_ANOMALY_PCT=100
ALERT_ANOMALY_MIN_VOL_USD=5000
MAJOR_DIGEST_SEC=900

# CCTP bridge flow (config/watchlists/infra.yaml cctp: block has the contract addresses)
# BRIDGE_FLOW_USD / ALERT_BRIDGE_USD (below the shared thresholds) gate individual BRIDGE_INFLOW/BRIDGE_OUTFLOW posts.
# BRIDGE_FOLLOW_MIN_USD: only wallets arriving with at least this much are watched for BRIDGE_DEPLOY.
# BRIDGE_FOLLOW_MINUTES: how long after arrival a buy still counts as "deploying the bridged capital".
BRIDGE_FOLLOW_MIN_USD=10000
BRIDGE_FOLLOW_MINUTES=30
BRIDGE_DIGEST_SEC=300
# The corridor just opened: on first boot after adding it, raise WARM_START_HOURS to cover the time since the
# corridor's first mint (see infra.yaml cctp.note for the verification date) so no arrival before this process
# started is lost — in-memory windows/state are backfilled even though Discord stays muted for that history.

# Holder backfill for MAJOR_DIGEST holders≈ / top10% (background job; progress checkpointed in DB_PATH)
HOLDERS_BACKFILL=1
# QuickNode Discover caps getLogs at 5 blocks — history scans go to the public archive RPC instead (chainId-checked at boot)
HOLDERS_RPC_URL=https://rpc.arc-scan.org
HOLDERS_RPC_MAX_RPS=2
HOLDERS_BACKFILL_RANGE=10000
HOLDERS_BACKFILL_MAX_BLOCKS=30000000
HOLDERS_SYNC_SEC=60
HOLDERS_CHECKPOINT_SEC=120

# Major price source: deepest trusted pool must hold at least this much USDC (dust pools never price a major)
MAJOR_PRICE_MIN_LP_USD=1000
MAJOR_DEPTH_REFRESH_SEC=300
