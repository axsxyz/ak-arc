{
  "name": "@ak-arc/radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arc (Circle L1) liquidity radar -> Discord",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/index.ts",
    "start:mainnet-poll": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning ARC_PROFILE=mainnet-poll tsx src/index.ts",
    "start:mainnet": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning ARC_PROFILE=mainnet tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run test/unit",
    "test:fixtures": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run test/fixtures",
    "test:alerts": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run test/alerts",
    "test:chain-probe": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/chain-probe.ts",
    "probe:mainnet": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning ARC_PROFILE=mainnet-poll tsx src/tools/chain-probe.ts",
    "test:webhooks:dry": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/webhooks-dry.ts",
    "test:webhooks": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning ALLOW_LIVE_WEBHOOKS=1 tsx src/tools/webhooks-dry.ts --once",
    "fixtures:gen": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/gen-fixtures.ts",
    "discover:factories": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/discover-factories.ts",
    "discover:onchain": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/discover-onchain.ts",
    "report:precision": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/precision-report.ts",
    "report:scorecard": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/scorecard.ts",
    "calibrate": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/calibrate.ts",
    "harness": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/tools/harness.ts",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "viem": "^2.56.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
