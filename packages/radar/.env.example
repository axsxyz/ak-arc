# radar .env (copy to .env; .env is gitignored).
# Every variable the radar reads. Placeholder values only. Commented-out
# lines show the built-in default (src/config/env.ts) and can stay unset.
# Precedence: shell > config/profiles/<ARC_PROFILE>.env > .env

# --- network ---------------------------------------------------------------
# testnet | mainnet
ARC_NETWORK=testnet
ARC_TESTNET_HTTP_URL=https://YOUR-RPC-PROVIDER.example/arc-testnet/KEY
ARC_TESTNET_WSS_URL=wss://YOUR-RPC-PROVIDER.example/arc-testnet/KEY
# Public HTTP RPC (chain 5042) is enough for probes/discovery and for the
# mainnet-poll profile. The WebSocket mode needs a provider WSS endpoint.
ARC_MAINNET_HTTP_URL=https://rpc.arc-scan.org
ARC_MAINNET_WSS_URL=
# Generic overrides (take precedence over the per-network URLs above)
# ARC_HTTP_URL=
# ARC_WSS_URL=
# ARC_CHAIN_ID=
# Non-secret preset from config/profiles/<name>.env (mainnet-poll | mainnet)
# ARC_PROFILE=

# --- Discord sink -----------------------------------------------------------
DISCORD_WH_SMART_FLOW=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WH_MAJOR_COINS=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WH_LAUNCHPADS=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_WH_ALERTS=https://discord.com/api/webhooks/ID/TOKEN
# Kill-switches: dry-run logs payloads instead of POSTing. Flip to 0 to go live.
DISCORD_DRY_RUN=1
ALERTS_PING_ENABLED=1
# DISCORD_USERNAME=

# --- alert thresholds (defaults shown) --------------------------------------
# ALERT_LP_USD=50000
# ALERT_LP_WINDOW_SEC=120
# ALERT_LP_WATCH_USD=10000
# ALERT_MIGRATE_VOL_USD=10000
# ALERT_MIGRATE_WINDOW_SEC=300
# ALERT_WALLET_AGE_SEC=120
# ALERT_WALLET_BUY_USD=500
# ALERT_ANOMALY_Z=5
# ALERT_ANOMALY_PCT=100
# ALERT_ANOMALY_MIN_SAMPLES=30
# ALERT_ANOMALY_MIN_VOL_USD=1000
# ALERT_ANOMALY_COOLDOWN_SEC=900
# Early-buyer density: N unique buyers within the first M blocks of a pool
# EARLY_BUYER_BLOCKS=20
# EARLY_BUYER_MIN_COUNT=8
# CLUSTER_MIN_WALLETS=3
# PAD_TIME_TO_USD=69000
# BRIDGE_FLOW_USD=25000
# ALERT_BRIDGE_USD=250000
# BRIDGE_FOLLOW_MIN_USD=10000
# BRIDGE_FOLLOW_MINUTES=30
# DEDUPE_SEC=60

# --- digests ------------------------------------------------------------------
# MAJOR_DIGEST_SEC=300
# MAJOR_PRICE_MIN_LP_USD=1000
# MAJOR_DEPTH_REFRESH_SEC=300
# PAD_LEADERBOARD_SEC=3600
# BRIDGE_DIGEST_SEC=300

# --- paper scorecard (never changes posting, pings or kill-switches) ----------
# PAPER_LATENCY_MS=3000
# PAPER_SIZE_USD=500

# --- ingestion ------------------------------------------------------------------
# RPC_GETLOGS_MAX_RANGE=5
# RPC_MAX_RPS=10
# BACKFILL_MAX_BLOCKS=2400
# HEAD_STALL_SEC=30
# ALLOW_MAINNET_HTTP_POLLING=0
# POLL_INTERVAL_MS=1000
# WARM_START_HOURS=0
# ALLOW_EMPTY_CHAIN=0
# Chaos testing: force-drop the WebSocket every N seconds (0 = off)
# CHAOS_WS_DROP_SEC=0

# --- holder backfill (background job) -------------------------------------------
# HOLDERS_BACKFILL=1
# HOLDERS_RPC_URL=https://rpc.arc-scan.org
# HOLDERS_RPC_MAX_RPS=2
# HOLDERS_BACKFILL_RANGE=10000
# HOLDERS_BACKFILL_MAX_BLOCKS=30000000
# HOLDERS_SYNC_SEC=60
# HOLDERS_CHECKPOINT_SEC=120

# --- storage / logging ------------------------------------------------------------
# DB_PATH=data/radar.sqlite
# WATCHLIST_DIR=config/watchlists
# LOG_LEVEL=info

# --- diagnostic tools only (src/tools/*) ---------------------------------------------
# cctp-probe.ts
# BASE_RPC_URL=https://mainnet.base.org
# TM_V2_BASE=
# USDC_BASE=
# EXECUTOR_ADDRESS=
# EXTRA_CCTP_ADDR=
# webhooks-dry.ts: set to 1 to really POST test payloads
# ALLOW_LIVE_WEBHOOKS=
