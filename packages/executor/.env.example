# executor .env (copy to .env; .env is gitignored).
#
# This file holds the repo's ONLY signing key. The radar must never load it
# (enforced by packages/radar/test/unit/repo-layout.test.ts).
#
# SECRETS AND SWITCHES ONLY. Everything else lives in config/executor.json,
# which may never contain a URL, a key or a kill-switch (validated at boot).
# src/config.ts is the only module that reads these.

# Signing key for the wallet that burns on Base, receives on Arc, and swaps.
# Same address on both chains. With or without the 0x prefix.
PRIVATE_KEY=0x

# RPCs. Public endpoints work but rate-limit bursts.
BASE_RPC_URL=https://mainnet.base.org
# Comma-separated failover list. The first is used first; after
# ARC_RPC_ROTATE_AFTER consecutive transport failures the next one takes
# over (per call, no restart). Each endpoint's chainId is asserted at first
# use; a wrong-chain endpoint is dropped for the session.
ARC_MAINNET_HTTP_URL=https://rpc.arc-scan.org,https://YOUR-RPC-PROVIDER.example/arc-mainnet/KEY
ARC_RPC_ROTATE_AFTER=3
# Optional. When set, the sell TUI subscribes over WebSocket; when empty it
# polls over HTTP every timing.statePollMs.
ARC_MAINNET_WSS_URL=
# Arc reader rate (requests/s) for pool enumeration and state reads. The
# public RPC throttles above ~5. --rps overrides per run.
ARC_RPC_MAX_RPS=5
# Base backoff in ms for throttled reads (6 attempts, doubling).
ARC_RPC_RETRY_BASE_MS=400

# Circle attestation API (production host).
IRIS_API_URL=https://iris-api.circle.com

# Discord. Never pings. DISCORD_DRY_RUN=1 (default) logs payloads instead of
# POSTing. One webhook for every stage.
DISCORD_WH_EXECUTOR=https://discord.com/api/webhooks/ID/TOKEN
DISCORD_DRY_RUN=1

# Execution kill-switch. 1 (default) = nothing is signed. --live on the CLI
# overrides it for one run; --live always needs an explicit --amount.
EXECUTION_DRY_RUN=1

# sell.ts: extra token addresses to track as positions beyond
# trade.targetToken and trade.tokens' keys (comma-separated).
EXTRA_TOKENS=

# status.ts only: a Base burn tx hash to report attestation status for.
PENDING_BURN_TX=
